{
  "manifest_version": 3,
  "name": "Claude AI - Gemini Controller",
  "version": "1.0.0",
  "description": "Control Claude AI website using your own Google Gemini Free API Key on Mobile & Desktop",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://claude.ai/*",
    "*://*.claude.ai/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://claude.ai/*",
        "*://*.claude.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
